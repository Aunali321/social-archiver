# ============================================
# Shared
# ============================================

TELEGRAM_BOT_TOKEN=xxxxxxxx
TELEGRAM_CHAT_ERRORS=xxxxx

# Telegram File Upload Limits
TELEGRAM_MAX_FILE_SIZE_MB=50
# TELEGRAM_BOT_API_URL=http://localhost:8081  # Uncomment for self-hosted API

# Self-hosted Bot API (get from https://my.telegram.org)
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash

# Behavior
CHECK_INTERVAL_MINUTES=30
FETCH_BATCH_SIZE=200
CLEANUP_DOWNLOADS=true

# Embedding / VLM (optional, shared across platforms)
EMBEDDING_ENABLED=false
VLM_PROVIDER=vertex  # "vertex", "gemini", or "openrouter"

# Vertex AI (default provider) — auth via GOOGLE_APPLICATION_CREDENTIALS
VERTEX_MODEL=gemini-3-flash-preview
VERTEX_PROJECT=
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Gemini API (VLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (VLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
VLM_MODEL=google/gemini-2.5-flash-lite

EMBEDDING_TIMEOUT=300

# Search
SEARCH_HYBRID_TOPK=50
SEARCH_RRF_K=60
SEARCH_RERANK_TOPN=10

# ============================================
# Instagram
# ============================================

INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_DM_USERNAME=your_private_account_username
INSTAGRAM_SESSIONID=your_sessionid_cookie_optional

TELEGRAM_CHAT_LIKES=-xxxxx
TELEGRAM_CHAT_SAVED=-xxxxxxx
TELEGRAM_CHAT_SHARED=-xxxxxx

INSTAGRAM_MILVUS_URI=./data/instagram_embeddings.db

# ============================================
# Twitter/X
# ============================================

# Get from browser cookies at x.com: DevTools > Application > Cookies > x.com
TWITTER_AUTH_TOKEN=your_auth_token_cookie
TWITTER_CT0=your_ct0_cookie

TWITTER_CHAT_LIKES=-xxxxx
TWITTER_CHAT_BOOKMARKS=-xxxxx

TWITTER_MILVUS_URI=./data/twitter_embeddings.db
