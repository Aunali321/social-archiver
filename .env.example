# ============================================
# Shared
# ============================================

TELEGRAM_BOT_TOKEN=xxxxxxxx
TELEGRAM_CHAT_ERRORS=xxxxx

# Telegram File Upload Limits
TELEGRAM_MAX_FILE_SIZE_MB=50
# TELEGRAM_BOT_API_URL=http://localhost:8081  # Uncomment for self-hosted API

# Self-hosted Bot API (get from https://my.telegram.org)
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash

# Behavior
# How often each daemon runs a full cycle. 240 = every 4 hours; shared by all platforms.
CHECK_INTERVAL_MINUTES=240
FETCH_BATCH_SIZE=200
CLEANUP_DOWNLOADS=true

# Embedding / VLM (optional, shared across platforms)
EMBEDDING_ENABLED=false
VLM_PROVIDER=vertex  # "vertex", "gemini", or "openrouter"

# Vertex AI (default provider) — auth via GOOGLE_APPLICATION_CREDENTIALS
VERTEX_MODEL=gemini-3-flash-preview
VERTEX_PROJECT=
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Gemini API (VLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (VLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
VLM_MODEL=google/gemini-2.5-flash-lite

EMBEDDING_TIMEOUT=300

# Search
SEARCH_HYBRID_TOPK=50
SEARCH_RRF_K=60
SEARCH_RERANK_TOPN=10

# ============================================
# Instagram
# ============================================

INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_SESSIONID=your_sessionid_cookie_optional

# Whose DM thread to walk for the `shared` category. Setting it is what enables that
# category; leave it empty and only likes and saved are archived.
INSTAGRAM_DM_USERNAME=your_private_account_username

# Upload only. Archiving runs without any of these; items wait at upload_status=pending
# until a channel exists for their category.
TELEGRAM_CHAT_LIKES=-xxxxx
TELEGRAM_CHAT_SAVED=-xxxxxxx
TELEGRAM_CHAT_SHARED=-xxxxxx

INSTAGRAM_MILVUS_URI=./data/instagram_embeddings.db

# ============================================
# Twitter/X
# ============================================

# Get from browser cookies at x.com: DevTools > Application > Cookies > x.com
TWITTER_AUTH_TOKEN=your_auth_token_cookie
TWITTER_CT0=your_ct0_cookie

# Official data export (Settings -> Download an archive of your data), .zip or extracted
# dir. like.js backfills the full like history past the timeline cap. Likes only —
# bookmarks are not in exports.
TWITTER_EXPORT_PATH=./data/twitter_export.zip

TWITTER_CHAT_LIKES=-xxxxx
TWITTER_CHAT_BOOKMARKS=-xxxxx

TWITTER_MILVUS_URI=./data/twitter_embeddings.db

# ============================================
# Reddit
# ============================================

# Create an app at https://www.reddit.com/prefs/apps (client_id is under the app name).
# An "installed app" issues only a client_id (no secret) — recommended.
REDDIT_CLIENT_ID=your_client_id
REDDIT_USER_AGENT=social-archiver by u/your_username

# Recommended auth: run `uv run python scripts/reddit_auth.py` to get a refresh token
# via a one-time browser login (no stored password, 2FA handled by the browser).
REDDIT_REFRESH_TOKEN=

# Alternative: a "script" app (client_id + secret) with username/password. Does not
# work with 2FA unless the password is "password:TOTP". Leave blank if using a token.
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Account data export (https://www.reddit.com/settings/data-request), a .zip or an
# extracted directory. Backfills the full saved/vote/own history past the 1000 cap.
REDDIT_EXPORT_PATH=./data/reddit_export.zip
# Export refs hydrated, expanded and committed per chunk; a stopped run resumes from the DB
REDDIT_EXPORT_BATCH=250

REDDIT_CHAT_SAVED=-xxxxx
REDDIT_CHAT_UPVOTED=-xxxxx
REDDIT_CHAT_DOWNVOTED=-xxxxx
REDDIT_CHAT_OWN=-xxxxx

REDDIT_MILVUS_URI=./data/reddit_embeddings.db
